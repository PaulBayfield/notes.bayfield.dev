# Copy to server/.env for local runs, or pass these to the container.

# Where the workspace is reachable (the workspace URL, sign-in redirects, share links).
PUBLIC_URL=https://notes.bayfield.dev
PORT=3000

# PostgreSQL 17. Docker Compose sets this for you; for local development: npm run db:dev
DATABASE_URL=postgres://postgres:notes@127.0.0.1:5442/notes
# DATABASE_POOL_MAX=10

# Signs collaboration tokens. At least 32 characters: openssl rand -hex 32
SECRET_KEY=

# The workspace's name before an import or the first settings change.
# TEAM_NAME=Notes
# The language new accounts start with (Outline's DEFAULT_LANGUAGE).
# DEFAULT_LANGUAGE=fr_FR

# --- Sign in with Authentik (any OIDC provider), with Outline's variable names ---
# The provider's redirect URI is ${PUBLIC_URL}/auth/oidc.callback, as Outline's: switching servers needs
# no change at the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Authentik
# OIDC_SCOPES=openid profile email
# OIDC_USERNAME_CLAIM=preferred_username
# Comma-separated groups allowed to sign in (empty: anyone the provider lets through).
# OIDC_ALLOWED_GROUPS=

# Local development without the provider: sign straight in as this user. Only honoured when
# PUBLIC_URL is http://localhost; leave unset everywhere else.
# DEV_LOGIN_USER=demo

# --- Files (attachments, avatars, exports) ---
# A folder on a volume (the image uses /var/lib/notes/data).
# FILE_STORAGE_DIR=./data/files
# The largest upload, in bytes (Outline's FILE_STORAGE_UPLOAD_MAX_SIZE).
# FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Header your reverse proxy puts the visitor IP in (behind a Cloudflare Tunnel: cf-connecting-ip).
# CLIENT_IP_HEADER=cf-connecting-ip
# SESSION_IDLE_DAYS=90
