{
  "name": "notes-server",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "description": "Notes server: an Outline-compatible API, collaboration and realtime server, and the web build",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "check": "tsc --noEmit",
    "db:dev": "node scripts/dev-db.ts",
    "import:outline": "node --env-file-if-exists=.env scripts/import-outline.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "^1.1.3",
    "@hocuspocus/server": "^1.1.3",
    "@hono/node-server": "^2.1.9",
    "fflate": "^0.8.3",
    "fractional-index": "^1.0.0",
    "hono": "^4.13.19",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "ws": "^8.23.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "~7.0.2"
  }
}
